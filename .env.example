# Codex Turn - Environment Variables
# Copy this file to .env and fill in your values

# Responses API (upstream OpenAI-compatible endpoint)
RESPONSES_API_BASE_URL=https://api.openai.com
RESPONSES_API_KEY=

# Completions API (optional, defaults to same as Responses)
COMPLETIONS_API_BASE_URL=https://api.openai.com
COMPLETIONS_API_KEY=

# Proxy listener
HOST=127.0.0.1
PORT=9090
