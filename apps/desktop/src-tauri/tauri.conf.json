{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Turn",
  "version": "0.1.4",
  "identifier": "com.codexturn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../.. && npm run build --workspace @codex-turn/converter && npm run build --workspace @codex-turn/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Turn",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/converter/dist/src": "packages/converter/dist/src",
      "../../../packages/converter/package.json": "packages/converter/package.json"
    }
  }
}
